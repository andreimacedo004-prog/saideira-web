# Copie para .env.local (fica fora do Git) e ajuste.

# Endereco do backend
VITE_API_URL=http://localhost:8280

# Fotos do check-in (opcional). Sem isso o app funciona, so que sem foto.
# Crie uma conta gratis no Cloudinary e um "upload preset" do tipo Unsigned
# (Settings > Upload > Upload presets). Veja o README.
VITE_CLOUDINARY_CLOUD=
VITE_CLOUDINARY_PRESET=
